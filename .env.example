# ==============================================================================
# Sing-Box Enterprise Audit Dashboard Environment Variables
# ==============================================================================

# ClickHouse Configuration
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=audit
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# File System Directories
DATA_DIR=/app/data
GEOIP_DIR=/app/data/geoip

# MaxMind GeoLite2 Offline Database URLs
# Fast CDN mirror URLs by default; can be replaced with custom mirror or MaxMind subscription URL
GEOIP_COUNTRY_URL=https://fastly.jsdelivr.net/gh/P3TERX/GeoLite.mmdb@download/GeoLite2-Country.mmdb
GEOIP_ASN_URL=https://fastly.jsdelivr.net/gh/P3TERX/GeoLite.mmdb@download/GeoLite2-ASN.mmdb

# Auto Update Configuration
GEOIP_AUTO_UPDATE=true
GEOIP_UPDATE_INTERVAL_HOURS=24

# Timezone (UTC for database timestamp consistency; web UI automatically renders in browser local timezone)
TZ=UTC
